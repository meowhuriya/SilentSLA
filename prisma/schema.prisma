datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model SLAPolicy {
  id                  String     @id @default(uuid())
  serviceName         String     @unique
  vendor              String
  availabilityTarget  Float
  measurementPeriod   String
  claims              Claim[]
  incidents           Incident[]
}

model Incident {
  id                  String     @id @default(uuid())
  slaPolicyId         String
  slaPolicy           SLAPolicy  @relation(fields: [slaPolicyId], references: [id])
  startTime           DateTime
  endTime             DateTime?
  durationMinutes     Float?
  evidenceSource      String
  isExcluded          Boolean    @default(false)
}

model Claim {
  id                  String     @id @default(uuid())
  slaPolicyId         String
  slaPolicy           SLAPolicy  @relation(fields: [slaPolicyId], references: [id])
  totalDowntime       Float
  claimPackage        String
  status              String
  createdAt           DateTime   @default(now())
}
